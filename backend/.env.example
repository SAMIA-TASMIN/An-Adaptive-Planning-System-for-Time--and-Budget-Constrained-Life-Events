# Local: copy this file to backend/.env and fill in YOUR values.
# Vercel: add the same names in Project > Settings > Environment Variables.
# NEVER put real passwords in this file. It is committed to GitHub.
PORT=5000
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR-CLUSTER.mongodb.net/an-adaptive-planning?retryWrites=true&w=majority
JWT_SECRET=put_a_long_random_text_here
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
